{
  "name": "Eagle Logistics Public Site",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [5173, 4173],
  "portsAttributes": {
    "5173": { "label": "Public site (share this)", "onAutoForward": "notify" },
    "4173": { "label": "Vite preview", "onAutoForward": "silent" }
  },
  "postCreateCommand": "npm install && npm run sync:content",
  "postStartCommand": "node scripts/codespaces-demo.mjs",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"]
    }
  },
  "remoteUser": "node"
}
