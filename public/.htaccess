# Eagle Logistics - Apache rules for cPanel (static SPA)
# Canonical: https://www.eaglelogistics.in

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS + www (single hop to canonical host)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.eaglelogistics\.in$ [NC]
  RewriteRule ^ https://www.eaglelogistics.in%{REQUEST_URI} [L,R=301]

  # React Router (BrowserRouter) - serve index.html for non-file routes
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Marketing JSON is unhashed; avoid sticky caches after re-upload
<IfModule mod_headers.c>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
