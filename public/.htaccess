# Eagle Logistics - Apache rules for cPanel (pre-rendered static site)
# Canonical: http://www.eaglelogistics.in (switch to https once SSL is installed)
#
# Safe to upload to new.eaglelogistics.in too: the www redirect below
# only fires on the main eaglelogistics.in domain.

# Do not expose directory listings for /assets, /content, etc.
Options -Indexes

# /things-we-send is both a page (things-we-send.html) and a folder of sub-pages;
# don't let Apache append a trailing slash to folder names.
DirectorySlash Off

# Unknown URLs get a real 404 status with the pre-rendered "Page not found" page
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Main domain only: send eaglelogistics.in to www (canonical host).
  # HTTP for now: the hosting plan has no valid SSL certificate yet (the old
  # one expired Dec 2023), and forcing HTTPS would show visitors a warning page.
  RewriteCond %{HTTP_HOST} ^eaglelogistics\.in$ [NC]
  RewriteRule ^ http://www.eaglelogistics.in%{REQUEST_URI} [L,R=301]

  # Once a valid certificate covers eaglelogistics.in + www, replace the two
  # lines above with these, and change http:// to https:// in sitemap.xml,
  # robots.txt, PageMeta.jsx, settings.json and settingsDefaults.js:
  # RewriteCond %{HTTP_HOST} ^(www\.)?eaglelogistics\.in$ [NC]
  # RewriteCond %{HTTPS} !=on [OR]
  # RewriteCond %{HTTP_HOST} ^eaglelogistics\.in$ [NC]
  # RewriteRule ^ https://www.eaglelogistics.in%{REQUEST_URI} [L,R=301]

  # Old site (until Nov 2026) used /Home/<Page>.html - send those links and
  # their Google rankings to the matching new pages.
  RewriteRule ^Home/?$ / [NC,R=301,L]
  RewriteRule ^Home/(index|Create)\.html$ / [NC,R=301,L]
  RewriteRule ^Home/About\.html$ /about [NC,R=301,L]
  RewriteRule ^Home/Services\.html$ /services [NC,R=301,L]
  RewriteRule ^Home/Tracking\.html$ /tracking [NC,R=301,L]
  RewriteRule ^Home/Contact\.html$ /contact [NC,R=301,L]
  RewriteRule ^Home/Specialoffers\.html$ /offers [NC,R=301,L]
  RewriteRule ^Home/Things_We_Send\.html$ /things-we-send [NC,R=301,L]
  RewriteRule ^Home/Books\.html$ /things-we-send/books [NC,R=301,L]
  RewriteRule ^Home/Clothes\.html$ /things-we-send/clothes [NC,R=301,L]
  RewriteRule ^Home/Electronics\.html$ /things-we-send/electronics [NC,R=301,L]
  RewriteRule ^Home/Medicines\.html$ /things-we-send/medicines [NC,R=301,L]
  RewriteRule ^Home/Photos\.html$ /things-we-send/photos [NC,R=301,L]
  RewriteRule ^Home/Spices\.html$ /things-we-send/spices [NC,R=301,L]
  RewriteRule ^Home/Sweets\.html$ /things-we-send/sweets [NC,R=301,L]
  RewriteRule ^Home/Footwears\.html$ /things-we-send/footwear [NC,R=301,L]
  RewriteRule ^Home/Air\.html$ /cargo/air [NC,R=301,L]
  RewriteRule ^Home/Ship\.html$ /cargo/sea [NC,R=301,L]
  RewriteRule ^Home/Surface\.html$ /cargo/surface [NC,R=301,L]

  # Drop trailing slashes (except the home page) so each page has one URL
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # Offers admin (React page, pre-rendered as admin.html; the PHP API lives in /api/)
  RewriteRule ^admin(/.*)?$ admin.html [L]

  # Pre-rendered pages: /services -> services.html, /cargo/air -> cargo/air.html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # Anything else that isn't a real file falls through to ErrorDocument 404
</IfModule>

<IfModule mod_headers.c>
  # Marketing JSON is unhashed; avoid sticky caches after re-upload
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Security headers for every page
  # - other sites can't show this site inside a frame (clickjacking)
  # - browsers must not guess file types (stops uploaded files acting as scripts)
  # - only the domain (not full page paths) is sent to other sites
  # - no camera/mic/location access for any page
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # After SSL is installed, also add (tells browsers to always use https):
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # The admin is never cached and never indexed
  <FilesMatch "^admin\.html$">
    Header always set Cache-Control "no-store"
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>
